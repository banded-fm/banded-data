# The Pollstar crawler as its own long process (~1 request/second for hours),
# next to concertdb.service. Started daily by concertdb-pollstar.timer.
#
# Install alongside concertdb.service / concertdb.timer (see that file):
#   cp deploy/concertdb-pollstar.service deploy/concertdb-pollstar.timer ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now concertdb-pollstar.timer
[Unit]
Description=banded-data Pollstar capture
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/banded-data
EnvironmentFile=%h/banded-data/.env
ExecStart=%h/banded-data/.venv/bin/concertdb pollstar
Nice=10
TimeoutStartSec=23h
